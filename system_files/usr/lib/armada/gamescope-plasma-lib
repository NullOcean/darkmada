source "${ARMADA_PLASMA_CONFIG_LIB:-/usr/lib/armada/plasma-config-lib}"

armada_gamescope_plasma_exec() {
    local mode=$1 kwin_config=${2:-} scale=${3:-}
    shift $(( $# < 3 ? $# : 3 ))
    local shell=/usr/bin/plasmashell
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    local kwin_home="${config_home}/armada/${kwin_config}"
    local -a kwin_env=() first_run=()
    local child_env= file

    if [[ -z "${DISPLAY:-}" ]]; then
        echo "${0##*/}: nested Gamescope did not provide an X11 display" >&2
        return 1
    fi

    armada_plasma_activate_config "$mode"

    export XDG_CURRENT_DESKTOP=KDE
    export QT_QPA_PLATFORMTHEME=KDE
    export DISABLE_GAMESCOPE_WSI=1
    unset GAMESCOPE_WAYLAND_DISPLAY GAMESCOPE_LIMITER_FILE

    if [[ "$mode" == mobile ]]; then
        shell='/usr/bin/plasmashell -p org.kde.plasma.mobileshell'
        export XDG_CONFIG_DIRS="$HOME/.config/plasma-mobile:/etc/xdg${XDG_CONFIG_DIRS:+:$XDG_CONFIG_DIRS}"
        export QT_QUICK_CONTROLS_STYLE=org.kde.breeze
        export QT_QUICK_CONTROLS_MOBILE=true
        export PLASMA_INTEGRATION_USE_PORTAL=1
        export PLASMA_PLATFORM=phone:handset

        # As startplasmamobile does: Plasma Mobile's KWin settings, including the on-screen keyboard.
        QT_QPA_PLATFORM=offscreen "${ARMADA_PLASMA_MOBILE_ENVMANAGER:-/usr/bin/plasma-mobile-envmanager}" --apply-settings
    fi

    if [[ -n "$kwin_config" ]]; then
        # KWin applies an EDID-less panel's saved mode and rotation to its window here, then overwrites them.
        install -d -m 0700 "$kwin_home"
        for file in kdeglobals kxkbrc kcminputrc kglobalshortcutsrc; do
            ln -sfn "../../$file" "$kwin_home/$file"
        done
        kwin_env=(/usr/bin/env XDG_CONFIG_HOME="$kwin_home")
        child_env="/usr/bin/env XDG_CONFIG_HOME=${config_home@Q} "

        # KWin saves the output on first start; after that the user's scale stands.
        if [[ -n "$scale" && ! -e "$kwin_home/kwinoutputconfig.json" ]]; then
            first_run=("/usr/bin/kscreen-doctor output.X11-0.scale.$scale")
        fi
    fi

    exec "${ARMADA_DBUS_RUN_SESSION:-/usr/bin/dbus-run-session}" \
        "${kwin_env[@]}" \
        "${ARMADA_KWIN_WAYLAND:-/usr/bin/kwin_wayland}" \
        --x11-display "$DISPLAY" \
        --fullscreen \
        --no-lockscreen \
        --xwayland \
        "$@" \
        --exit-with-session "${child_env}${shell}" \
        "${child_env}/usr/libexec/kf6/polkit-kde-authentication-agent-1" \
        "${first_run[@]}"
}
