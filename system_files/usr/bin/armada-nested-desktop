#!/bin/bash
set -euo pipefail

source "${ARMADA_GAMESCOPE_PLASMA_LIB:-/usr/lib/armada/gamescope-plasma-lib}"

systemctl=${ARMADA_SYSTEMCTL:-/usr/bin/systemctl}
systemd_run=${ARMADA_SYSTEMD_RUN:-/usr/bin/systemd-run}
bottom=armada-bottom-screen.service

# Steam's xcb keeps the shell's panels from mapping; its IM modules leave Qt apps without text input.
unset LD_PRELOAD LC_ALL QT_QPA_PLATFORM QT_IM_MODULE GTK_IM_MODULE
export XDG_SESSION_TYPE=wayland
export ARMADA_NESTED_DESKTOP=$$

# Two shells cannot share Plasma's config. The unit outlives Steam killing this tree, to restart the bottom one.
"$systemd_run" --user --quiet --collect --unit="armada-nested-desktop-$$" /bin/bash -c '
    tail --pid="$1" -f /dev/null
    systemctl --user is-active --quiet gamescope-session-plus@steam.service || exit 0
    systemctl --user is-enabled --quiet "$2" || exit 0
    # A relaunch may already be running under its own unit.
    ! systemctl --user list-units --plain --no-legend --state=active "armada-nested-desktop-*.service" |
        grep -qv "^armada-nested-desktop-$1\.service " || exit 0
    exec systemctl --user start "$2"
' _ "$$" "$bottom"
"$systemctl" --user stop "$bottom"

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
kwin_config=nested-desktop
mode=desktop
kwin_args=(--inputmethod /usr/bin/plasma-keyboard)
if grep -Eqs '^desktop_session[[:space:]]*=[[:space:]]*"armada-plasma-mobile\.desktop"' "$config_home/steamos-manager/state.toml"; then
    # Plasma Mobile sets up its own keyboard.
    mode=mobile
    kwin_args=()
fi

# 2 also raises the keyboard on a click; the default is touch only, and touch arrives here as a pointer.
kwinrc="$config_home/armada/$kwin_config/kwinrc"
if [[ ! -e "$kwinrc" ]]; then
    install -D -m 0600 /dev/null "$kwinrc"
    printf '[Wayland]\nVirtualKeyboardMode=2\n' >"$kwinrc"
fi

# Scaled as Desktop Mode is.
armada_gamescope_plasma_exec "$mode" "$kwin_config" 1.5 "${kwin_args[@]}"
